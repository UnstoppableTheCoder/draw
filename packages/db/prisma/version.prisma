model BoardVersion {
    id String @id @default(uuid())

    roomId String

    room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

    createdById String

    createdBy User @relation(fields: [createdById], references: [id])

    message String?

    snapshot Json

    createdAt DateTime @default(now())

    @@index([roomId, createdAt])
    @@index([createdById])
}
