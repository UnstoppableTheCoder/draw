model Invite {
  id String @id @default(uuid())

  roomId String

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  email String

  role RoomRole

  token String @unique

  expiresAt DateTime

  accepted Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([roomId, email])
  @@index([expiresAt])
}
