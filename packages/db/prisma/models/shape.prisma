model Shape {
    id String @id

    // Relations
    pageId      String
    page        Page   @relation(fields: [pageId], references: [id], onDelete: Cascade)
    createdById String
    createdBy   User   @relation(fields: [createdById], references: [id])

    // Geometry
    // type   ShapeType
    type   String
    x      Float
    y      Float
    width  Float
    height Float
    angle  Float  @default(0)

    // Appearance
    appearance Json

    // Metadata
    groupId      String?
    frameId      String?
    zIndex       String
    seed         Int
    version      Int     @default(1)
    versionNonce Int
    isDeleted    Boolean @default(false)
    locked       Boolean @default(false)
    link         String?

    // Shape Specific Data
    data Json

    // Audit
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    // Relations
    comments Comment[]

    // Indexes
    @@index([pageId])
    @@index([pageId, zIndex])
    @@index([pageId, groupId])
    @@index([pageId, frameId])
}
